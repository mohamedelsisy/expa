# Runtime configuration. Nuxt reads NUXT_-prefixed variables when the SERVER STARTS (not at build time),
# so the same image works in every environment.

# Laravel API origin used by the BFF (server side only; the browser never sees it). REQUIRED in production.
NUXT_API_BASE_URL=http://127.0.0.1:8001/api/v1
# Public origin of this web app (canonical URLs, hreflang, og:url, sitemap, robots). REQUIRED in production.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Number of reverse proxies in front of this server that APPEND to X-Forwarded-For (0 = none: use the socket address).
# The resolved client IP is forwarded to the API (add the web host to the API's TRUSTED_PROXIES).
NUXT_TRUSTED_PROXY_HOPS=0
# Send Strict-Transport-Security. Only enable when every access path is https.
NUXT_SECURITY_HSTS=false
# Auth cookie Secure flag: auto (production or X-Forwarded-Proto=https) | true | false
NUXT_COOKIE_SECURE=auto

# A production build refuses to start when the two origins above are empty or point at localhost.
# Set to 1 only for local runs of a production build (docker compose, e2e).
# EXPA_ALLOW_LOCAL=1
