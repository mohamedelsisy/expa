# Laravel environment for api / queue / scheduler containers (production). Copy to api.env, fill, chmod 600. NEVER commit.
# Every key below is documented in docs/ENVIRONMENT.md. Values marked __SECRET__ come from the secret manager.
# Gate: `scripts/preflight.sh` (php artisan expa:preflight --production) must pass before traffic is switched.

APP_NAME=EXPA
APP_ENV=production
APP_KEY=__SECRET__            # php artisan key:generate --show ; custody in docs/SECURITY.md
APP_DEBUG=false
APP_URL=https://api.example.com
FRONTEND_URL=https://www.example.com
CORS_ALLOWED_ORIGINS=https://www.example.com
APP_TIMEZONE=Europe/Rome
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

# Reverse proxy: the Docker subnet of docker-compose.prod.yml (edge + web live here). Not "*".
BEHIND_PROXY=true
TRUSTED_PROXIES=172.28.0.0/16

LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_STACK=daily
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=expa
DB_USERNAME=expa
DB_PASSWORD=__SECRET__        # equals MYSQL_PASSWORD in db.env

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=__SECRET__     # equals REDIS_PASSWORD in redis.env
REDIS_PREFIX=expa-prod-
REDIS_QUEUE_RETRY_AFTER=900

SANCTUM_TOKEN_EXPIRATION=43200
EXPORT_REQUIRE_PASSWORD=true
CONTENT_FOUR_EYES=true
JOBS_SSRF_DNS_CHECK=true
PRIVACY_POLICY_VERSION=__SET_AFTER_COUNSEL_APPROVAL__

# Antivirus (clamav service in docker-compose.prod.yml)
DOCUMENTS_ENCRYPT=true
DOCUMENTS_SCANNER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=5
CLAMAV_FAIL_CLOSED=true

# Mail (real provider; SPF/DKIM/DMARC on the sending domain)
MAIL_MAILER=smtp
MAIL_HOST=smtp.provider.example
MAIL_PORT=587
MAIL_SCHEME=null
MAIL_USERNAME=__SECRET__
MAIL_PASSWORD=__SECRET__
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=EXPA

# AI
AI_DRIVER=anthropic
ANTHROPIC_API_KEY=__SECRET__
AI_MODEL=claude-sonnet-5-5
AI_DAILY_TOKEN_BUDGET=__SET_FROM_MONTHLY_BUDGET__

# Push (service-account JSON mounted as a read-only file outside the web root, or FCM_CREDENTIALS_JSON from the secret manager)
PUSH_DRIVER=fcm
FCM_CREDENTIALS_PATH=/run/secrets/fcm-service-account.json

# Billing: keep `none` until the payment items in docs/LAUNCH_QUEUE.md are closed
BILLING_PROVIDER=none
# STRIPE_SECRET_KEY=__SECRET__
# STRIPE_WEBHOOK_SECRET=__SECRET__
# STRIPE_API_VERSION=__PIN__
BILLING_SEED_PLANS_ACTIVE=false

# OCR (tesseract is NOT in the stock backend image: see docs/EXTERNAL_SERVICES.md section 9)
OCR_DRIVER=null

COMMUNITY_ENABLED=false
LEARNING_REQUIRE_TEACHER_REVIEW=true
