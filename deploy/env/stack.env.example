# Compose-level variables (read with --env-file). No secrets here.
API_IMAGE=registry.example.com/expa-api:REPLACE_WITH_GIT_SHA
WEB_IMAGE=registry.example.com/expa-web:REPLACE_WITH_GIT_SHA
API_HOST=api.example.com
WEB_HOST=www.example.com
# Directory holding <host>/fullchain.pem and <host>/privkey.pem for API_HOST and WEB_HOST
CERTS_DIR=./deploy/certs
