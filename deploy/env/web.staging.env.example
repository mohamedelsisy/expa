# Nuxt runtime (names are exact; see docs/DEPLOYMENT.md "Web runtime environment"). No secrets: the BFF holds none.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
# Must equal the origin of APP_URL in api.env (verification links). The edge container aliases API_HOST inside the network.
NUXT_API_BASE_URL=https://api.staging.example.com/api/v1
NUXT_PUBLIC_SITE_URL=https://www.staging.example.com
# One reverse proxy (the edge nginx) appends to X-Forwarded-For
NUXT_TRUSTED_PROXY_HOPS=1
NUXT_SECURITY_HSTS=true
NUXT_COOKIE_SECURE=auto
# NEVER set EXPA_ALLOW_LOCAL in staging or production.
