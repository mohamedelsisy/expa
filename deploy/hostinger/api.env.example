# Laravel .env for Hostinger shared hosting (Premium/Business). Copy to ~/expa-api/.env on the server, fill, chmod 600.
# NEVER commit the real file. Every key is documented in docs/ENVIRONMENT.md; the walkthrough is docs/HOSTINGER.md.
APP_NAME=EXPA
APP_ENV=production
APP_KEY=                       # php artisan key:generate --show  (keep a copy in your password manager: losing it makes encrypted data unreadable)
APP_DEBUG=false
APP_URL=https://api.example.com
FRONTEND_URL=https://www.example.com
CORS_ALLOWED_ORIGINS=https://www.example.com
APP_TIMEZONE=Europe/Rome
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# Shared hosts sit behind Hostinger's proxy/CDN. Start with `*` ONLY if the origin is reachable exclusively through it,
# then verify with the "proxy identity check" in docs/HOSTINGER.md; tighten to the proxy's CIDRs if Hostinger publishes them.
BEHIND_PROXY=true
TRUSTED_PROXIES=*

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

# MySQL created in hPanel > Databases (host is usually localhost).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u000000000_expa
DB_USERNAME=u000000000_expa
DB_PASSWORD=

# No Redis on shared hosting: database-backed cache, queue and sessions. The queue is drained by cron (see guide).
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database

SANCTUM_TOKEN_EXPIRATION=43200
STAFF_2FA_REQUIRED=true
EXPORT_REQUIRE_PASSWORD=true
CONTENT_FOUR_EYES=true
JOBS_SSRF_DNS_CHECK=true
PRIVACY_POLICY_VERSION=__SET_AFTER_COUNSEL_APPROVAL__

# Antivirus: ClamAV cannot run on shared hosting. Keep `clamav` + fail-closed: uploads of personal documents are then
# REJECTED (safe) until you point CLAMAV_HOST at a reachable clamd. Do NOT switch to `basic` in production.
DOCUMENTS_ENCRYPT=true
DOCUMENTS_SCANNER=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_FAIL_CLOSED=true

# Mail: create a mailbox in hPanel > Emails and use its SMTP settings (SPF/DKIM are set up there for your domain).
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=hello@example.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=EXPA

# AI: keep a spend limit on the Anthropic key. `fake` only returns placeholder text and fails preflight in production.
AI_DRIVER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_DAILY_TOKEN_BUDGET=200000

PUSH_DRIVER=log
BILLING_PROVIDER=none
BILLING_SEED_PLANS_ACTIVE=false
OCR_DRIVER=null
COMMUNITY_ENABLED=false
LEARNING_REQUIRE_TEACHER_REVIEW=true
