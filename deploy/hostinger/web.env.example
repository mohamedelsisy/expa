# Environment for the Nuxt web app (Hostinger hPanel > Node.js app > Environment variables). Read at server start.
NODE_ENV=production
NUXT_API_BASE_URL=https://api.example.com/api/v1
NUXT_PUBLIC_SITE_URL=https://www.example.com
NUXT_TRUSTED_PROXY_HOPS=1
NUXT_COOKIE_SECURE=true
NUXT_SECURITY_HSTS=true
# Advertising, optional (docs/ADS.md):
# NUXT_PUBLIC_ADS_ENABLED=true
# NUXT_PUBLIC_ADS_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
