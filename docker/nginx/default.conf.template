# Rendered by the nginx image (envsubst) into /etc/nginx/conf.d/default.conf. Variables: API_HOST, WEB_HOST.
# Certificates: mounted read-only at /etc/nginx/certs/<host>/{fullchain.pem,privkey.pem} (see deploy/README in docs/DEPLOYMENT.md).

# --- plain HTTP: ACME challenge + redirect ---
server {
    listen 80 default_server;
    server_name _;
    location /.well-known/acme-challenge/ { root /var/www/acme; }
    location = /edge-health { access_log off; return 200 "ok\n"; add_header Content-Type text/plain; }
    location / { return 301 https://$host$request_uri; }
}

# --- API (php-fpm) ---
server {
    listen 443 ssl;
    http2 on;
    server_name ${API_HOST};

    ssl_certificate     /etc/nginx/certs/${API_HOST}/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/${API_HOST}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    include /etc/nginx/snippets/security.conf;
    add_header Cache-Control "no-store" always;

    # 12m = the app cap (10 MB per file, config/documents.php) plus multipart overhead; php.ini post_max_size=14M.
    client_max_body_size 12m;
    client_body_timeout 30s;
    limit_conn expa_conn 40;

    # Only the API and the framework health route are exposed. Everything else (including /storage, /.env) is a 404.
    location = /up { include /etc/nginx/snippets/fastcgi.conf; }
    location ^~ /api/v1/auth/ { limit_req zone=expa_auth burst=20 nodelay; include /etc/nginx/snippets/fastcgi.conf; }
    location ^~ /api/ { limit_req zone=expa_api burst=60 nodelay; include /etc/nginx/snippets/fastcgi.conf; }
    # Payment webhooks must never be dropped by the edge limiter (the app has its own throttle:billing-webhook).
    location ^~ /api/v1/billing/webhook/ { include /etc/nginx/snippets/fastcgi.conf; }
    location / { return 404; }
}

# --- Web (Nuxt, node) ---
server {
    listen 443 ssl;
    http2 on;
    server_name ${WEB_HOST};

    ssl_certificate     /etc/nginx/certs/${WEB_HOST}/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/${WEB_HOST}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    include /etc/nginx/snippets/security.conf;   # do not strip the CSP the app sends (proxy_hide_header is NOT used)
    client_max_body_size 12m;
    limit_conn expa_conn 80;

    location / {
        limit_req zone=expa_web burst=100 nodelay;
        proxy_pass http://web:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
    }

    # Hashed Nuxt assets are immutable; HTML (location /) is never cached at the edge.
    location /_nuxt/ {
        proxy_pass http://web:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/security.conf;
    }
}
