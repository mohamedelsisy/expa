APP_NAME=EXPA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- EXPA ---
# Environments: local | staging | production (set APP_ENV). Never commit real credentials.
# Supported locales (ar default, en, it) are defined in config/expa.php
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000
# LLM provider (live AI is disabled until a key is set; tests use a fake client)
AI_DRIVER=fake
ANTHROPIC_API_KEY=
APP_TIMEZONE=Europe/Rome

# --- Production checklist (staging/production) ---
# APP_ENV=production   APP_DEBUG=false   (never true outside local)
# APP_URL must be the https origin of this API (verification links are built from it; the web BFF checks it)
# AI_DRIVER=anthropic + ANTHROPIC_API_KEY=<secret manager>; DOCUMENTS_SCANNER=<real scanner>; JOBS_SSRF_DNS_CHECK=true
# QUEUE_CONNECTION=redis (or database) with a running worker; run `php artisan schedule:work` (or cron every minute)
# TRUSTED_PROXIES=10.0.0.0/8   (addresses of your load balancer / reverse proxy; "*" only on a private network)
