APP_NAME=EXPA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
# production: warning (default when APP_ENV=production). Never debug in production.
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Production REQUIRES a delivering mailer (preflight fails on log/array). Example:
#   MAIL_MAILER=smtp  MAIL_SCHEME=smtps|null  MAIL_HOST=smtp.provider.example  MAIL_PORT=465|587
#   MAIL_USERNAME / MAIL_PASSWORD from the secret manager; MAIL_FROM_ADDRESS on a domain with SPF/DKIM/DMARC
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- EXPA ---
# Environments: local | staging | production (set APP_ENV). Never commit real credentials.
# Supported locales (ar default, en, it) are defined in config/expa.php
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000
# LLM provider (live AI is disabled until a key is set; tests use a fake client)
AI_DRIVER=fake
ANTHROPIC_API_KEY=
APP_TIMEZONE=Europe/Rome

# --- Proxy (BE-1) ---
# Comma separated proxy IPs/CIDRs of your load balancer; "*" only on a private network. Read from config, so it works with config:cache.
TRUSTED_PROXIES=
# Set false ONLY when the API is exposed directly (no balancer). Production preflight fails if BEHIND_PROXY=true and TRUSTED_PROXIES is empty.
BEHIND_PROXY=true
EXPA_STAFF_TOKEN_MINUTES=720
# Staff two-factor (TOTP). true = staff without 2FA get 403 two_factor_setup_required on every /admin route. MUST be true in production (preflight error).
STAFF_2FA_REQUIRED=false
TWO_FACTOR_ISSUER=EXPA
TWO_FACTOR_CHALLENGE_TTL=300
EXPA_MAX_TOKENS=20
EXPORT_REQUIRE_PASSWORD=false

# --- AI (Anthropic) ---
AI_MODEL=claude-sonnet-5-5
AI_TIMEOUT_SECONDS=20
AI_RETRIES=2
AI_MAX_OUTPUT_TOKENS=900
AI_MAX_INPUT_CHARS=24000
# Global daily cost circuit breaker (input+output tokens across all users); 0 = off
AI_DAILY_TOKEN_BUDGET=0

# --- Uploads antivirus (ClamAV) ---
# basic = heuristics only (non-production). Production: clamav (preflight fails on basic).
DOCUMENTS_SCANNER=basic
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# CLAMAV_SOCKET=/var/run/clamav/clamd.ctl
CLAMAV_TIMEOUT=5
CLAMAV_FAIL_CLOSED=true

# --- Push (FCM HTTP v1) ---
PUSH_DRIVER=log
# FCM_CREDENTIALS_PATH=/run/secrets/fcm-service-account.json   (or FCM_CREDENTIALS_JSON; never commit)
# FCM_PROJECT_ID=

# --- Billing ---
# none | fake (dev/tests) | stripe
BILLING_PROVIDER=none
# STRIPE_SECRET_KEY=   STRIPE_WEBHOOK_SECRET=   STRIPE_PRICE_PLUS=   STRIPE_PRICE_PRO=
BILLING_GRACE_DAYS=7
BILLING_DUNNING_REMINDER_DAYS=3,6
# BILLING_TAX_COUNTRY=   (VAT rates are never hard-coded: set plans.vat_rate or add verified tax_rates rows)
# BILLING_SEED_PLANS_ACTIVE=false

# --- Production checklist (staging/production) ---
# APP_ENV=production   APP_DEBUG=false   (never true outside local)
# APP_URL must be the https origin of this API (verification links are built from it; the web BFF checks it)
# AI_DRIVER=anthropic + ANTHROPIC_API_KEY=<secret manager>; DOCUMENTS_SCANNER=<real scanner>; JOBS_SSRF_DNS_CHECK=true
# CACHE_STORE=redis  QUEUE_CONNECTION=redis (BE-9) with a supervised worker (--timeout=600, retry_after 900); cron `schedule:run` every minute
# MAIL_MAILER=smtp, DOCUMENTS_SCANNER=clamav, LOG_LEVEL=warning, TRUSTED_PROXIES set
# TRUSTED_PROXIES=10.0.0.0/8   (addresses of your load balancer / reverse proxy; "*" only on a private network)

# Document explainer / OCR (docs/SECURITY.md). null = no OCR, clients fall back to pasted text.
OCR_DRIVER=null
# OCR_TESSERACT_BINARY=
# OCR_LANGUAGES=ita+eng+ara
# EXPLAIN_MAX_FILE_KB=8192
# EXPLAIN_MAX_PIXELS=25000000
# EXPLAIN_MAX_PDF_PAGES=5

# Housing checker
# HOUSING_MAX_CHARS=12000
# HOUSING_RETENTION_DAYS=90

# Learning / patente
# LEARNING_REQUIRE_TEACHER_REVIEW=false
# PATENTE_LEGACY_RIGHTS_NOTE=true

# --- Community / marketplace / moderation (RA-8) ---
COMMUNITY_ENABLED=false
# COMMUNITY_PREMODERATION=new_users   (new_users | all)
# COMMUNITY_ERASE_TEXT=false
# MODERATION_MAX_LINKS=2
# MODERATION_NEW_ACCOUNT_DAYS=3
# MARKETPLACE_LIST_UNVERIFIED=true
# MARKETPLACE_VERIFICATION_DAYS=365
# MARKETPLACE_REVIEW_MIN_ACCOUNT_HOURS=24
# MARKETPLACE_LEAD_RETENTION_DAYS=365

# --- Explainer / OCR limits (RA-8) ---
# EXPLAIN_MAX_DIMENSION=10000
# EXPLAIN_MAX_TEXT_CHARS=15000
# OCR_PDFTOTEXT_BINARY=   OCR_PDFTOPPM_BINARY=   OCR_TEMP_DIR=
# OCR_TIMEOUT_SECONDS=25

# --- Content, privacy, security (RA-8) ---
# CONTENT_FOUR_EYES=true   (false is a preflight ERROR in production)
# PRIVACY_POLICY_VERSION=2026-10-draft   (replaced automatically once a privacy document is published)
# OFFICIAL_DOMAINS_EXTRA=   OFFICIAL_DOMAIN_PATTERNS_ENABLED=true
# CORS_ALLOWED_ORIGINS=   (defaults to FRONTEND_URL)
# SANCTUM_TOKEN_EXPIRATION=43200   SANCTUM_TOKEN_PREFIX=
# APP_PREVIOUS_KEYS=   (comma separated old keys while rotating APP_KEY)
# DOCUMENTS_ENCRYPT=true   JOBS_SSRF_DNS_CHECK=true
# ANALYTICS_SYSTEM_EVENTS=true
# SEARCH_CACHE_TTL=60   SEARCH_MAX_TOKENS=6
# EXPA_MAX_DEVICES=10   EXPA_MAX_DOCUMENTS=200   EXPA_MAX_JOB_SAVES=500

# --- AI / push / billing tuning (RA-8) ---
# AI_RETRY_SLEEP_MS=400   ANTHROPIC_BASE_URL=https://api.anthropic.com
# FCM_API_BASE=https://fcm.googleapis.com   FCM_CREDENTIALS_JSON=   FCM_RETRY_SLEEP_MS=250   FCM_TIMEOUT=10
# STRIPE_API_BASE=https://api.stripe.com   STRIPE_API_VERSION=   STRIPE_TIMEOUT=15   STRIPE_WEBHOOK_TOLERANCE=300
# BILLING_FAKE_WEBHOOK_SECRET=   (only with BILLING_PROVIDER=fake)

